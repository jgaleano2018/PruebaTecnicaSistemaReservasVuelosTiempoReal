{
  "name": "realtime-gateway",
  "version": "1.0.0",
  "description": "Realtime Gateway: WebSocket (Socket.io) / SSE, gesti\u00f3n de conexiones, distribuci\u00f3n de eventos Kafka a clientes y escalabilidad horizontal",
  "main": "dist/main.js",
  "scripts": {
    "build:shared": "npm --prefix ../../cliente/shared install && npm --prefix ../../cliente/shared run build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reservas-vuelos/shared": "file:../../cliente/shared",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "socket.io-client": "^4.8.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 20000
  },
  "license": "MIT"
}
