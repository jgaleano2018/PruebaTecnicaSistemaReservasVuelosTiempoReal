# URLs de los servicios del backend (ver backend/docker-compose.yml)
# Monolito modular: Vuelos, Reservas, Clientes, Tiempo Real (SSE de respaldo), Analytics
VITE_MONOLITH_URL=http://localhost:3000/api/v1
# Flight Management Service: gestión de vuelos y dashboard de ocupación (HU4)
VITE_FMS_URL=http://localhost:3001/api/v1
# Payment Service: bloqueo de asiento + intención de pago (HU2) y pagos/reembolsos (HU3)
VITE_PAYMENT_URL=http://localhost:3002/api/v1
# Realtime Gateway (Socket.io). Recibe los eventos de Kafka y los distribuye por salas.
VITE_REALTIME_URL=http://localhost:4000
# Transporte en tiempo real: websocket (Socket.io, recomendado) | sse (respaldo por el gateway)
VITE_REALTIME_TRANSPORT=websocket
